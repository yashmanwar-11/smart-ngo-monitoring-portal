# National NGO Real-Time Monitoring & Inspection Portal
# Configuration & Environment Variables

# Backend Port (Default: 5000)
PORT=5000

# SQLite Relational Database Location
DATABASE_PATH="./data/ngo_portal.db"

# JWT Secret for Session & Bearer Token Authentication
JWT_SECRET="INSPIRA_PROTOTYPE_SIH2026_JWT_SECRET_KEY"

# Statutory Geofence Check-in Perimeter Radius in Metres (Standard: 150m)
INSPECTION_GEOFENCE_RADIUS=150

# Environment Mode
NODE_ENV="development"
